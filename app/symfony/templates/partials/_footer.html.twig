<footer class="footer" role="contentinfo">
    <div class="container">
        <div class="footer-content">
            <div class="footer-brand">
                <img src="{{ asset('images/logo-navbar.svg') }}" alt="" class="footer-logo" aria-hidden="true">
                <span>Passe Civique</span>
            </div>

            <nav class="footer-links" aria-label="Liens rapides">
                <a href="{{ path('app_home') }}">Accueil</a>
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('app_quiz_start') }}">Quiz</a>
                    <a href="{{ path('app_profile') }}">Profil</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Connexion</a>
                    <a href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </nav>

            <nav class="footer-legal" aria-label="Informations legales">
                <a href="{{ path('app_cgu') }}">Conditions d'utilisation</a>
                <a href="{{ path('app_privacy') }}">Politique de confidentialite</a>
                <a href="{{ path('app_legal_notices') }}">Mentions legales</a>
            </nav>

            <p class="text-muted">
                <small>&copy; {{ "now"|date("Y") }} Passe Civique - Tous droits reserves</small>
            </p>
        </div>
    </div>
</footer>
