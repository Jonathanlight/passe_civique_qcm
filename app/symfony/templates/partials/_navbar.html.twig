<nav class="navbar" role="navigation" aria-label="Navigation principale">
    <div class="container">
        <div class="navbar-inner">
            <a href="{{ path('app_home') }}" class="navbar-brand" aria-label="Passe Civique - Retour a l'accueil">
                <img src="{{ asset('images/logo-navbar.svg') }}" alt="" class="navbar-logo" aria-hidden="true">
                <span>Passe Civique</span>
            </a>

            <div class="navbar-nav" role="menubar">
                <a href="{{ path('app_home') }}"
                   class="nav-link {{ app.request.get('_route') == 'app_home' ? 'active' }}"
                   role="menuitem"
                   {% if app.request.get('_route') == 'app_home' %}aria-current="page"{% endif %}>
                    Accueil
                </a>

                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('app_quiz_start') }}"
                       class="nav-link {{ app.request.get('_route') starts with 'app_quiz' ? 'active' }}"
                       role="menuitem"
                       {% if app.request.get('_route') starts with 'app_quiz' %}aria-current="page"{% endif %}>
                        Quiz
                    </a>
                    <a href="{{ path('app_profile') }}"
                       class="nav-link {{ app.request.get('_route') starts with 'app_profile' ? 'active' }}"
                       role="menuitem"
                       {% if app.request.get('_route') starts with 'app_profile' %}aria-current="page"{% endif %}>
                        Mon Profil
                    </a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}"
                           class="nav-link {{ app.request.get('_route') starts with 'app_admin' ? 'active' }}"
                           role="menuitem"
                           {% if app.request.get('_route') starts with 'app_admin' %}aria-current="page"{% endif %}>
                            Admin
                        </a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm" role="menuitem">
                        Deconnexion
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}"
                       class="nav-link {{ app.request.get('_route') == 'app_login' ? 'active' }}"
                       role="menuitem"
                       {% if app.request.get('_route') == 'app_login' %}aria-current="page"{% endif %}>
                        Connexion
                    </a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm" role="menuitem">
                        Inscription
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>
