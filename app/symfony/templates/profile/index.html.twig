{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="page-content">
    <div class="container">
        <div class="profile-header">
            <div class="profile-avatar">
                {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
            </div>
            <div class="profile-info">
                <h1>{{ user.fullName }}</h1>
                {% if user.gamificationLevel %}
                    <div class="profile-level">
                        <span class="profile-level-emoji">{{ user.gamificationLevel.emoji }}</span>
                        <span>{{ user.gamificationLevel.name }}</span>
                    </div>
                {% endif %}
            </div>
            <div style="margin-left: auto;">
                <a href="{{ path('app_profile_edit') }}" class="btn btn-secondary">
                    Modifier mon profil
                </a>
            </div>
        </div>

        <div class="stats-grid mb-8">
            <div class="stat-card">
                <div class="stat-icon">🎯</div>
                <div class="stat-value">{{ stats.totalQuizzes }}</div>
                <div class="stat-label">Quiz completes</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">✅</div>
                <div class="stat-value">{{ stats.passedQuizzes }}</div>
                <div class="stat-label">Quiz reussis</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">📊</div>
                <div class="stat-value">{{ stats.averageScore|number_format(1) }}%</div>
                <div class="stat-label">Score moyen</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">🏆</div>
                <div class="stat-value">{{ stats.bestScore|number_format(1) }}%</div>
                <div class="stat-label">Meilleur score</div>
            </div>
        </div>

        {% if nextLevel %}
            <div class="level-progress">
                <div class="level-progress-header">
                    <div>
                        <strong>Progression vers le niveau suivant</strong>
                        <div class="text-muted" style="font-size: 0.875rem;">
                            {{ nextLevel.emoji }} {{ nextLevel.name }}
                        </div>
                    </div>
                    <div class="text-blue" style="font-size: 1.25rem; font-weight: 700;">
                        {{ levelProgress.percentage|number_format(0) }}%
                    </div>
                </div>
                <div class="progress">
                    <div class="progress-bar" style="width: {{ levelProgress.percentage }}%;"></div>
                </div>
                {% if not levelProgress.isMaxLevel %}
                    <div class="level-progress-info">
                        {% if levelProgress.quizzesNeeded > 0 %}
                            Encore {{ levelProgress.quizzesNeeded }} quiz reussi{{ levelProgress.quizzesNeeded > 1 ? 's' : '' }} necessaire{{ levelProgress.quizzesNeeded > 1 ? 's' : '' }}
                        {% endif %}
                        {% if levelProgress.scoreNeeded > 0 %}
                            {% if levelProgress.quizzesNeeded > 0 %} et {% endif %}
                            un score moyen de {{ nextLevel.minAverageScore }}% requis
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <div class="mt-8">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2 class="mb-0">Historique recent</h2>
                <a href="{{ path('app_profile_history') }}" class="btn btn-secondary btn-sm">
                    Voir tout
                </a>
            </div>

            {% if recentQuizzes|length > 0 %}
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Configuration</th>
                            <th>Score</th>
                            <th>Resultat</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for quiz in recentQuizzes %}
                            <tr>
                                <td>{{ quiz.finishedAt|date('d/m/Y H:i') }}</td>
                                <td>{{ quiz.configuration.name }}</td>
                                <td>{{ quiz.correctAnswers }}/{{ quiz.totalQuestions }} ({{ quiz.scorePercent|number_format(0) }}%)</td>
                                <td>
                                    {% if quiz.isPassed %}
                                        <span class="status-badge success">Reussi</span>
                                    {% else %}
                                        <span class="status-badge danger">Echec</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('app_quiz_results', {id: quiz.id}) }}" class="btn btn-sm btn-outline">
                                        Voir details
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="card text-center card-no-hover">
                    <p class="text-muted mb-4">Vous n'avez pas encore complete de quiz.</p>
                    <a href="{{ path('app_quiz_start') }}" class="btn btn-primary">
                        Commencer mon premier quiz
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="text-center mt-8">
            <a href="{{ path('app_quiz_start') }}" class="btn btn-primary btn-lg">
                Demarrer un nouveau quiz
            </a>
        </div>
    </div>
</div>
{% endblock %}
