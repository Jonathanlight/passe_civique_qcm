{% extends 'base.html.twig' %}

{% block title %}Reinitialiser le mot de passe{% endblock %}

{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">Nouveau mot de passe</h1>
            <p class="auth-subtitle">Choisissez un nouveau mot de passe securise</p>
        </div>

        <form method="post">
            <div class="form-group">
                <label for="password" class="form-label">Nouveau mot de passe</label>
                <input type="password" name="password" id="password" class="form-control"
                       required autofocus minlength="8"
                       placeholder="********">
                <p class="form-help">Minimum 8 caracteres</p>
            </div>

            <div class="form-group">
                <label for="password_confirm" class="form-label">Confirmer le mot de passe</label>
                <input type="password" name="password_confirm" id="password_confirm" class="form-control"
                       required minlength="8"
                       placeholder="********">
            </div>

            <button type="submit" class="btn btn-primary btn-block btn-lg">
                Reinitialiser le mot de passe
            </button>
        </form>

        <div class="auth-footer">
            <a href="{{ path('app_login') }}">Retour a la connexion</a>
        </div>
    </div>
</div>
{% endblock %}
